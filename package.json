{
  "name": "restaurant-webapp-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "npm run clean && next dev -p 3001",
    "dev:clean": "npm run dev",
    "dev:3001": "npm run dev",
    "dev:3000": "npm run clean && next dev -p 3000",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "next": "^15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.3.1",
    "typescript": "5.8.3"
  }
}
